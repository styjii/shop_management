DJANGO_SECRET_KEY="change-me"
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ALLOWED_ORIGINS="http://localhost:4200"

# Compte administrateur créé par `python manage.py setup_defaults`
# (si le mot de passe est vide, un mot de passe aléatoire est généré et affiché une fois)
DJANGO_DEFAULT_ADMIN_USERNAME=admin
DJANGO_DEFAULT_ADMIN_PASSWORD=
