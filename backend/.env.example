DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Compte administrateur créé par `python manage.py setup_defaults`
# (si le mot de passe est vide, un mot de passe aléatoire est généré et affiché une fois)
DJANGO_DEFAULT_ADMIN_USERNAME=admin
DJANGO_DEFAULT_ADMIN_PASSWORD=

# Inscription libre : 1 = chacun peut demander un compte (activé ensuite par un gestionnaire)
REGISTRATION_ENABLED=1

# Adresse de l'application Angular, utilisée dans les liens des e-mails
FRONTEND_URL=http://localhost:4200

# E-mails (mot de passe oublié). En développement (DJANGO_DEBUG=1) ils s'affichent dans le
# terminal ; en production, renseignez votre serveur SMTP.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Shop Management <no-reply@example.com>
