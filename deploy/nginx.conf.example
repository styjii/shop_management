# Exemple de configuration Nginx : sert Angular, relaie /api et /admin vers Gunicorn,
# sert les images (/media). Adaptez le nom de domaine et les chemins.

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

server {
    listen 80;
    server_name shop.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name shop.example.com;

    ssl_certificate     /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 3m;   # images : 2 Mo + marge

    # En-têtes de sécurité. Testez la CSP dans la console du navigateur après déploiement.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # API Django (Gunicorn). NUM_PROXIES=1 et TRUST_PROXY_SSL=1 dans .env.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # écrase toute valeur envoyée par le client
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/auth/token/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Administration Django (utilisez le même chemin que ADMIN_URL)
    location /admin/ {
        # allow 203.0.113.0/24;   # idéal : restreindre à vos adresses
        # deny all;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /static/ { alias /srv/shop/backend/staticfiles/; }

    # Images de produits : jamais d'exécution de script depuis /media
    location /media/ {
        alias /srv/shop/backend/media/;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Angular (repli vers index.html pour le routeur)
    root /srv/shop/frontend/dist/frontend/browser;
    location / { try_files $uri $uri/ /index.html; }
}
